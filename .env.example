COMPOSE_PROJECT_NAME=estuary-lab
FRONTEND_PORT=18202
BACKEND_PORT=19202
DB_PORT=17702
POSTGRES_DB=estuary
POSTGRES_USER=estuary
POSTGRES_PASSWORD=estuary_demo_change_me
JWT_SECRET=estuary_local_demo_secret_change_before_deploy_2026
SEED_DEMO=true
# 崩溃恢复参数（可选，使用默认值即可）
# 租约时长（秒）：worker 心跳续租，超时未续租视为进程退出，任务自动回收重投
RUN_LEASE_SECONDS=120
# 单次运行最大尝试次数，超出后标记 failed 等待人工处理
RUN_MAX_ATTEMPTS=5
# 恢复扫描间隔（秒）
RECOVERY_INTERVAL_SECONDS=30
